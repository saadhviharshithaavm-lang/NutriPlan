# Backend environment file. Copy to backend/.env for local development.
# Values must stay consistent with the root .env used by `docker compose`
# (same Postgres user/password/db) and with the host port bound in
# compose.yaml (5433, not Postgres's default 5432).

APP_NAME=NutriPlan API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Origins allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_USER=nutriplan
POSTGRES_PASSWORD=nutriplan_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=nutriplan
