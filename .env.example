# Root environment file: consumed by `docker compose` for the local Postgres
# container (compose.yaml). These are local-development-only placeholder
# values — never use them in production, and never commit a real `.env`.
#
# Copy this file to `.env` in the repo root before running `docker compose up -d db`.

POSTGRES_USER=nutriplan
POSTGRES_PASSWORD=nutriplan_dev_only
POSTGRES_DB=nutriplan
