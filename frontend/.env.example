# Frontend environment file. Copy to frontend/.env for local development.
#
# Not currently required: in development, calls to /api are forwarded to the
# backend by the Vite dev proxy (see vite.config.ts), so no API base URL
# needs to be configured. Reserved here for a future production build where
# the frontend may be served separately from the backend.

# VITE_API_BASE_URL=/api/v1
